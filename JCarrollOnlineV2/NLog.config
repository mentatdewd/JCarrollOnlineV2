<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
      internalLogFile="c:\temp\nlog-internal.log">

  <!-- Define various log targets -->
  <targets async="true">
    
    <!-- File Target - All logs -->
    <target xsi:type="File" 
            name="allfile" 
            fileName="${basedir}/App_Data/logs/${shortdate}-all.log"
            layout="${longdate}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}"
            archiveFileName="${basedir}/App_Data/logs/archives/${shortdate}-all.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- File Target - Own logs only (application-specific) -->
    <target xsi:type="File" 
            name="ownFile-web" 
            fileName="${basedir}/App_Data/logs/${shortdate}-own.log"
            layout="${longdate}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}"
            archiveFileName="${basedir}/App_Data/logs/archives/${shortdate}-own.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- File Target - Errors only -->
    <target xsi:type="File" 
            name="errorFile" 
            fileName="${basedir}/App_Data/logs/${shortdate}-errors.log"
            layout="${longdate}|${event-properties:item=EventId_Id}|${uppercase:${level}}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}|${callsite}"
            archiveFileName="${basedir}/App_Data/logs/archives/${shortdate}-errors.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="30"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- Debug Output Window -->
    <target xsi:type="Trace" 
            name="debugger" 
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

    <!-- Console (for debugging) -->
    <target xsi:type="Console" 
            name="console"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}" />

    <!-- Colored Console -->
    <target xsi:type="ColoredConsole" 
            name="coloredConsole"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
            useDefaultRowHighlightingRules="false">
      <highlight-row condition="level == LogLevel.Debug" foregroundColor="DarkGray" />
      <highlight-row condition="level == LogLevel.Info" foregroundColor="Gray" />
      <highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
      <highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
      <highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
    </target>

  </targets>

  <!-- Rules to map from logger name to target -->
  <rules>
    
    <!-- All logs, including from Microsoft -->
    <logger name="*" minlevel="Trace" writeTo="allfile" />

    <!-- Skip non-critical Microsoft logs and only log own logs to ownFile-web -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <!-- Skip EntityFramework logs unless Error or higher -->
    <logger name="System.Data.Entity.*" maxlevel="Warn" final="true" />
    
    <!-- Application logs -->
    <logger name="JCarrollOnlineV2.*" minlevel="Debug" writeTo="ownFile-web" />
    
    <!-- Error logs only -->
    <logger name="*" minlevel="Error" writeTo="errorFile" />
    
    <!-- Debug output (Visual Studio Output Window) -->
    <logger name="*" minlevel="Info" writeTo="debugger" />
    
    <!-- Console output (when running console or IIS Express) -->
    <logger name="*" minlevel="Info" writeTo="coloredConsole" />

  </rules>
</nlog>