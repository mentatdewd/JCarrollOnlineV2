## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.sln.docstates
donotcheckintogit.txt

# User secrets and sensitive configs
secrets.xml
**/secrets.json
connectionStrings.config
*.config.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Dd]ebugPS/
[Rr]eleasePS/
[Bb]in/
[Oo]bj/
[Ll]ibs/
x64/
build/
bld/

# Unity build exceptions
!Content/games/Build
!Content/games/Build/*.unityweb
!Content/games/Build/*.wasm
!Content/games/Build/*.data
!Content/games/Build/*.js

# Visual Studio cache/options
.vs/
*.ide/

# Compiled files
*.dll
*.exe
*.pdb
*.obj
*.ilk
dlldata.c
*_i.c
*_p.c
*_i.h
*.meta
*.pch
*.pgc
*.pgd
*.tlb
*.tli
*.tlh

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml

# Build artifacts
*.rsp
*.sbr
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Chutzpah Test files
_Chutzpah*

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# TFS 2012 Local Workspace
$tf/

# Guidance Automation Toolkit
*.gpState

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode
.JustCode

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# MightyMoose
*.mm.*
AutoTest.Net/

# Sass
.sass-cache/

# InstallShield
[Ee]xpress/

# DocProject
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# Click-Once
publish/

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml

# NuGet Packages
packages/*
!packages/build/

# Azure Build Output
csx/
*.build.csdef

# Windows Store app
AppPackages/

# Others
sql/
*.Cache
ClientBin/
[Ss]tyle[Cc]op.*
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.pfx
*.publishsettings
node_modules/
package-lock.json

# RIA/Silverlight
Generated_Code/

# Upgrade backup files
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm

# SQL Server files
*.mdf
*.ldf

# Business Intelligence
*.rdl.data
*.bim.layout
*.bim_*.settings

# Unity build
!Content/games/Build/**/*

# Microsoft Fakes
FakesAssemblies/

# LightSwitch
GeneratedArtifacts/
_Pvt_Extensions/
ModelManifest.xml

